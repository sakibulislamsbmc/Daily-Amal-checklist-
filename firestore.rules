rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidDate(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document - Isolated strictly to authenticated owner
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow write: if isValidId(userId) && isOwner(userId)
        && request.resource.data.size() <= 30;
      allow list: if false;

      // Daily amol tracking subcollection
      match /dailyAmols/{dateId} {
        allow get, write, delete: if isValidId(userId) && isValidDate(dateId) && isOwner(userId)
          && request.resource.data.size() <= 20;
        allow list: if isValidId(userId) && isOwner(userId);
      }

      // Custom amol definitions subcollection
      match /customAmols/{amolId} {
        allow get, write, delete: if isValidId(userId) && isValidId(amolId) && isOwner(userId)
          && request.resource.data.size() <= 15;
        allow list: if isValidId(userId) && isOwner(userId);
      }
    }

    // Global site traffic & unique visitor counter
    match /siteStats/{statsId} {
      allow get, list: if true;
      allow create, update: if isValidId(statsId)
        && request.resource.data.size() <= 10;
    }

    // Individual unique visitor log
    match /visitors/{visitorId} {
      allow get: if isValidId(visitorId);
      allow create, update: if isValidId(visitorId)
        && request.resource.data.size() <= 10;
    }
  }
}
